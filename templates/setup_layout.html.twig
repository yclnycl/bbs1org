<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ title }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset_url('app/assets/index.svg') }}">
    {# 配色与尺寸直接取自主样式表的令牌，本页不再单独维护一套 #}
    <link rel="stylesheet" href="{{ app_url('app/assets/index.css') }}?v={{ app_version }}">
    <style>
    /* 仅初始化失败页需要的补充样式 */
    .init-wrap{
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: var(--sp-8) var(--sp-4)
    }

    .hero{
        display: grid;
        gap: var(--sp-2);
        margin-bottom: var(--sp-5)
    }

    .hero h1{
        color: var(--ink)
    }

    .hero p{
        margin: 0;
        color: var(--ink-3);
        font-size: var(--fs-lg)
    }

    .card .hd{
        padding: var(--sp-3) var(--sp-4);
        border-bottom: 1px solid var(--line)
    }

    .card .bd{
        padding: var(--sp-4)
    }

    .note{
        margin: 0;
        padding: var(--sp-3) var(--sp-4);
        border: 1px solid var(--brand-line);
        border-radius: var(--r-md);
        background: var(--brand-soft);
        color: var(--brand-strong);
        font-size: var(--fs-md);
        line-height: var(--lh-base);
        overflow-wrap: anywhere
    }

    .note.warn{
        border-color: var(--warning-line);
        background: var(--warning-soft);
        color: var(--warning)
    }
    </style>
</head>
<body>
<main class="wrap init-wrap">{% block content %}<div class="hero"><h1>初始化失败</h1><p>程序无法自动完成初始化。</p></div><div class="card"><div class="bd"><div class="note warn">{{ message }}</div></div></div>{% endblock %}</main>
</body>
</html>
