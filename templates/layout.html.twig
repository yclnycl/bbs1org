<!doctype html>
<html lang="{{ current_lang() == default_lang() ? 'zh-CN' : current_lang() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% if is_home and site_keywords != '' %}<meta name="keywords" content="{{ site_keywords }}">{% endif %}
    {% if seo_keywords != '' %}<meta name="keywords" content="{{ seo_keywords }}">{% endif %}
    {% if site_description != '' %}<meta name="description" content="{{ site_description }}">{% endif %}
    {% if seo_canonical %}<link rel="canonical" href="{{ seo_canonical }}">{% endif %}
    {% for alt_lang, alt_url in lang_alternates %}<link rel="alternate" hreflang="{{ alt_lang }}" href="{{ alt_url }}">{% endfor %}
    {% if seo_noindex %}<meta name="robots" content="noindex">{% endif %}
    {% if setting('google_verification') != '' %}<meta name="google-site-verification" content="{{ setting('google_verification') }}">{% endif %}
    {% if setting('baidu_verification') != '' %}<meta name="baidu-site-verification" content="{{ setting('baidu_verification') }}">{% endif %}
    {% if setting('bing_verification') != '' %}<meta name="msvalidate.01" content="{{ setting('bing_verification') }}">{% endif %}
    {% if setting('toutiao_verification') != '' %}<meta name="bytedance-verification-code" content="{{ setting('toutiao_verification') }}">{% endif %}
    {% if setting('so_verification') != '' %}<meta name="360-site-verification" content="{{ setting('so_verification') }}">{% endif %}
    {% if setting('sm_verification') != '' %}<meta name="shenma-site-verification" content="{{ setting('sm_verification') }}">{% endif %}
    {% if setting('sogou_verification') != '' %}<meta name="sogou_site_verification" content="{{ setting('sogou_verification') }}">{% endif %}
    <title>{{ page_title }}</title>
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:type" content="{{ seo_og_type }}">
    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:url" content="{{ seo_canonical ?: app_url() }}">
    <meta property="og:locale" content="{{ current_lang() == default_lang() ? 'zh_CN' : (current_lang() == 'en' ? 'en_US' : current_lang()) }}">
    {% if site_description != '' %}<meta property="og:description" content="{{ site_description }}">{% endif %}
    {% if seo_image != '' %}<meta property="og:image" content="{{ seo_image }}">{% endif %}
    <meta name="twitter:card" content="{{ seo_image != '' ? 'summary_large_image' : 'summary' }}">
    <meta name="twitter:title" content="{{ page_title }}">
    {% if site_description != '' %}<meta name="twitter:description" content="{{ site_description }}">{% endif %}
    {% if seo_image != '' %}<meta name="twitter:image" content="{{ seo_image }}">{% endif %}
    {{ seo_jsonld|raw }}
    <link rel="icon" type="image/svg+xml" href="{{ asset_url('app/assets/index.svg') }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site_name }}" href="{{ route_url('feed.xml') }}">
    <link rel="stylesheet" href="{{ app_url('app/assets/index.css') }}?v={{ app_version }}">
    {% block head %}{% endblock %}
</head>
<body data-contact-qr="{{ asset_url('app/assets/contact-qr.png') }}?v={{ app_version }}" data-contact-qr-title="{{ '添加微信'|t }}" data-contact-qr-alt="{{ '微信二维码'|t }}" data-contact-qr-hint="{{ '联系方式已隐藏。打开微信「扫一扫」扫描二维码，或在手机上长按识别二维码添加好友。'|t }}" data-contact-qr-aria="{{ '联系方式已隐藏，点击查看添加方式'|t }}" data-contact-qr-more="{{ '点击查看'|t }}">
<a class="skip-link" href="#main">{{ '跳到主要内容'|t }}</a>
{% if i18n_banner %}
<div class="lang-banner" id="lang-banner">
    <span>{{ '根据你的浏览器语言，已为你切换到英文版。'|t }}</span>
    <a href="{{ lang_switch_url(default_lang()) }}">{{ '切换到中文'|t }}</a>
    <button type="button" class="lang-banner-close" data-lang-banner-close aria-label="{{ '关闭'|t }}">{{ '继续使用英文'|t }}</button>
</div>
{% endif %}
{% include 'nav.html.twig' with {nav: nav} only %}
<main class="wrap" id="main">
    {% block content %}{% endblock %}
</main>
<footer class="footer">
    <div class="footer-inner">
        <p class="footer-brand">{{ site_name }} · {{ '全球旧衣行业资讯与交流社区'|t }}</p>
        <nav class="footer-links" aria-label="{{ '页脚导航'|t }}">
            <a href="{{ about_url }}">{{ '关于本站'|t }}</a>
            {% for tg in footer_tags %}
                <a href="{{ route_url('tag', {kw: tg}) }}">{{ tg }}</a>
            {% endfor %}
        </nav>
    </div>
</footer>
<div class="modal-backdrop" id="notify-modal" hidden>
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="notify-modal-title">
        <div class="modal-head"><strong id="notify-modal-title">提示</strong><button type="button" class="modal-close" data-modal-close aria-label="关闭">×</button></div>
        <div class="modal-body" id="notify-modal-body"></div>
    </div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
<button type="button" class="back-to-top" id="back-to-top" aria-label="返回顶部" hidden>
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M10 16V4M4.5 9.5 10 4l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
<script>window.__pageFlash={{ flash_json(flash) }};</script>
{# 百度统计：后台「统计」tab 配置 hm.js 脚本地址后全站插入；放在已有 script 之后，保证代码里 getElementsByTagName("script")[0] 能取到节点 #}
{% if setting('baidu_tongji_url') != '' %}
<script>
var _hmt = _hmt || [];
(function() {
  var hm = document.createElement("script");
  hm.src = "{{ setting('baidu_tongji_url')|js_string }}";
  var s = document.getElementsByTagName("script")[0];
  s.parentNode.insertBefore(hm, s);
})();
</script>
{% endif %}
{% block scripts %}{% endblock %}
<script src="{{ app_url('app/assets/index.js') }}?v={{ app_version }}" defer></script>
</body>
</html>
