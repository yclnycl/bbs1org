{% extends 'layout.html.twig' %}
{% block content %}
    <div class="home-shell"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel" data-slot="mainpanel_extra">
            <div class="breadcrumb"><a href="{{ route_url('home') }}">首页</a><span>/</span><a href="{{ route_url('forum', {id: forum.id}) }}">{{ forum.name }}</a></div>
            <div class="post-topic-title">
                <h1 class="post-content-title"><a href="{{ topic_url }}">{{ t.title }}</a></h1>
                {{ topic_stats_html(t.view_count, t.reply_count) }}
            </div>
            <ul class="post-list topic-post-list">
                {% if page == 1 %}
                    {{ topic_post_row(t, t.body, t.created_at, topic_ops) }}
                {% endif %}
                {% for r in reply_rows %}
                    {{ topic_post_row(r, r.body, r.created_at, r.ops, '', '', r.highlight, {reply_position: r.floor}) }}
                {% endfor %}
                {% if not replies and t.reply_count == 0 %}
                    <li class="empty-state">暂无回复</li>
                {% endif %}
            </ul>
            {% if pagination != '' %}<div class="pagination-bar">{{ pagination|raw }}</div>{% endif %}
            <div class="reply-panel" id="reply">
                <div class="reply-panel-head"><h3>发表回复</h3><span class="reply-status">{{ reply_status }}</span></div>
                {% if can_reply %}
                    <form class="ajax-reply-form" method="post" action="{{ route_url('reply_edit') }}" data-slot="reply.form_extra">
                        {{ form_token() }}
                        <input type="hidden" name="topic_id" value="{{ t.id }}">
                        {{ textarea('内容', 'body', '', true) }}
                        <button type="submit" data-loading-text="正在回复">回复</button>
                    </form>
                {% elseif not current_uid %}
                    <div class="reply-login-box"><a href="{{ route_url('login') }}">登录后回复</a></div>
                {% elseif not can_reply_forum %}
                    <div class="reply-login-box disabled">当前用户组无回帖权限</div>
                {% else %}
                    <div class="reply-login-box disabled">当前用户禁止发言</div>
                {% endif %}
            </div>
        </div></div>
        {{ sidebar_stack_html([sidebar_user_card_html(null, true)]) }}
    </div></div>
{% endblock %}
