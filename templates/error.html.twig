{% extends 'layout.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% block content %}
    <div class="home-shell"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel">
            <div class="form-panel form-error-panel">
                <h2>{{ error_title }}</h2>
                <p>{{ message != '' ? message : error_title }}</p>
            </div>
        </div></div>
        <aside class="sidebar">{{ ui.user_card() }}</aside>
    </div></div>
{% endblock %}
