{% extends 'admin/layout.html.twig' %}
{% import 'macros/form.html.twig' as f %}
{% block admin_body %}
    <div class="form-panel settings-form">
        <h2>收录监控（Search Console 近 28 天）</h2>
        {% if not gsc.configured %}
            <p>未配置凭证：把服务账号 JSON 放到数据卷 <code>app/data/gsc-service-account.json</code>。</p>
        {% else %}
            <form method="post">
                {{ f.token() }}
                <input type="hidden" name="action" value="gsc_perf_fetch">
                <div class="row settings-actions">
                    <button type="submit">刷新表现数据</button>
                    {% if gsc.perf_fetched_at %}<span>上次拉取：{{ gsc.perf_fetched_at|date('m-d H:i') }}</span>{% endif %}
                </div>
            </form>
            {% if gsc.perf %}
                <p>全站：展示 <strong>{{ gsc.perf.totals.impressions|number_format }}</strong>，点击 <strong>{{ gsc.perf.totals.clicks|number_format }}</strong>，平均排名 {{ gsc.perf.totals.position|round(1) }}；话题页有展现的 <strong>{{ gsc.perf.tag_reached }}</strong> 个（共 {{ tags|length }} 个）。</p>
                {% if gsc.perf.tag_pages %}
                    <table class="list admin-bulk-list">
                        <tr><th>话题页</th><th>展示</th><th>点击</th><th>平均排名</th></tr>
                        {% for p in gsc.perf.tag_pages %}
                            <tr>
                                <td><a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.kw }}</a></td>
                                <td>{{ p.impressions|number_format }}</td>
                                <td>{{ p.clicks }}</td>
                                <td>{{ p.position|round(1) }}</td>
                            </tr>
                        {% endfor %}
                    </table>
                {% else %}
                    <p class="empty-state">话题页还没有搜索展现——新建的话题词要等收录后才有数据。</p>
                {% endif %}
            {% elseif gsc.perf_fetched_at %}
                <p class="empty-state">缓存为空，点上方按钮刷新。</p>
            {% else %}
                <p class="empty-state">还没拉取过——点上方按钮。数据窗口为近 28 天（GSC 有 2-3 天滞后）。</p>
            {% endif %}
        {% endif %}
    </div>
    <div class="form-panel settings-form">
        <h2>站内搜索热词 → 候选话题词</h2>
        <p>已到站用户在站内搜索框真实输入的词（按搜索次数降序，中文页记录）。与上方 GSC 查询词互补：GSC 反映搜索引擎上的需求，这里反映已到站用户的需求。导入后 TDK 与英文译文由队列自动生成。当前共 <strong>{{ search_terms_total }}</strong> 个不同的词。</p>
        {% if search_terms %}
            <table class="list admin-bulk-list">
                <tr><th>搜索词</th><th>次数</th><th>最近搜索</th><th>操作</th></tr>
                {% for t in search_terms %}
                    <tr>
                        <td>{{ t.term }}</td>
                        <td>{{ t.hits }}</td>
                        <td>{{ t.last_at|date('m-d H:i') }}</td>
                        <td>
                            {% if t.is_tag %}
                                已是话题词
                            {% else %}
                                <form method="post">
                                    {{ f.token() }}
                                    <input type="hidden" name="action" value="import">
                                    <input type="hidden" name="query" value="{{ t.term }}">
                                    <select name="chain" aria-label="产业链环节">
                                        {% for c in chains %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
                                    </select>
                                    <button type="submit">导入</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
            <form method="post">
                {{ f.token() }}
                <input type="hidden" name="action" value="searchlog_clear">
                <div class="row settings-actions"><button type="submit">清空记录</button></div>
            </form>
        {% else %}
            <p class="empty-state">还没有搜索记录——访客在站内搜索后会自动聚合到这里。</p>
        {% endif %}
    </div>
    <div class="form-panel settings-form">
        <h2>Search Console 查询词 → 候选话题词</h2>
        {% if not gsc.configured %}
            <p>未配置凭证：把服务账号 JSON 放到数据卷 <code>app/data/gsc-service-account.json</code>（密钥不上传代码库），并在 GSC 后台把该服务账号加为本资源的用户。</p>
        {% else %}
            <p>拉取 GSC 真实查询词（按展示量降序），「站内命中」是该词的全文索引主题数，≥3 建页效果最好。导入后 TDK 与英文译文由队列自动生成。GSC 数据有 2-3 天滞后。</p>
            <form method="post">
                {{ f.token() }}
                <input type="hidden" name="action" value="gsc_fetch">
                <div class="row settings-actions">
                    <select name="days" aria-label="时间窗口">
                        <option value="28">最近 28 天</option>
                        <option value="90">最近 90 天</option>
                    </select>
                    <button type="submit">拉取查询词</button>
                    {% if gsc.fetched_at %}<span>上次拉取：{{ gsc.fetched_at|date('m-d H:i') }}</span>{% endif %}
                </div>
            </form>
            {% if gsc.queries %}
                <table class="list admin-bulk-list">
                    <tr><th>查询词</th><th>展示</th><th>点击</th><th>排名</th><th>站内命中</th><th>操作</th></tr>
                    {% for q in gsc.queries %}
                        <tr>
                            <td>{{ q.query }}</td>
                            <td>{{ q.impressions }}</td>
                            <td>{{ q.clicks }}</td>
                            <td>{{ q.position|round(1) }}</td>
                            <td>{{ q.hits }}{% if q.hits >= 3 %} ✓{% elseif q.hits > 0 %}（偏少）{% else %} ✗ 无命中{% endif %}</td>
                            <td>
                                {% if q.is_tag %}
                                    已是话题词
                                {% elseif q.hits > 0 %}
                                    <form method="post">
                                        {{ f.token() }}
                                        <input type="hidden" name="action" value="import">
                                        <input type="hidden" name="query" value="{{ q.query }}">
                                        <select name="chain" aria-label="产业链环节">
                                            {% for c in chains %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
                                        </select>
                                        <button type="submit">导入</button>
                                    </form>
                                {% else %}
                                    <small>无站内内容，先补数据</small>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </table>
            {% elseif gsc.fetched_at %}
                <p class="empty-state">查询词表为空——点上方「拉取查询词」。</p>
            {% endif %}
        {% endif %}
    </div>
    <div class="form-panel settings-form">
        <h2>批量导入候选词</h2>
        <p>每行一个关键词（# 开头的行跳过）。适合从关键词库报告或外部词表整批导入；摘要用模板句，TDK 队列会生成更完整的标题与描述。导入后自动提交 IndexNow 加速收录。</p>
        <form method="post">
            {{ f.token() }}
            <input type="hidden" name="action" value="import_bulk">
            <div class="row settings-actions">
                <select name="chain" aria-label="产业链环节">
                    {% for c in chains %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
                </select>
            </div>
            <div class="row settings-actions"><textarea name="keywords" rows="6" placeholder="每行一个关键词，如：&#10;羽绒服回收&#10;旧衣出口非洲&#10;# 这行是注释" style="width:100%"></textarea></div>
            <div class="row settings-actions"><button type="submit">批量导入</button></div>
        </form>
    </div>
    <div class="form-panel settings-form">
        <h2>新增话题词</h2>
        <p>话题词驱动 /tag/{关键词} 聚合页、首页侧栏、页脚与主题页「相关话题」内链。摘要用一句定义式陈述（会作为页面首段与 meta description 兜底），TDK 标题/描述由 SEO TDK 队列自动生成。</p>
        <form method="post">
            {{ f.token() }}
            <input type="hidden" name="action" value="add">
            {{ f.input('关键词', 'keyword', '', 'text', true, '2-30 个字符，站内语料中真实出现过的行业词') }}
            <div class="row settings-actions">
                <select name="chain" aria-label="产业链环节">
                    {% for c in chains %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
                </select>
            </div>
            <div class="row settings-actions"><textarea name="summary" rows="2" maxlength="500" placeholder="一句话定义式摘要，如：旧衣回收箱是设置在社区、学校等场所的衣物定点回收设施……" style="width:100%"></textarea></div>
            <div class="row settings-actions"><button type="submit">添加话题词</button></div>
        </form>
    </div>
    <div class="form-panel settings-form">
        <h2>词库管理（{{ tags|length }} 个）</h2>
        <p>停用后页面 404，并从 sitemap、侧栏、页脚与相关话题内链中消失；TDK 队列只处理启用中的词。改摘要后 TDK 不会自动重生成，如需更新可在 SEO TDK 页重跑或手工清掉对应记录。</p>
        <form method="post">
            {{ f.token() }}
            <input type="hidden" name="action" value="edit_all">
            <table class="list admin-bulk-list">
                <tr><th>排位</th><th>关键词</th><th>环节</th><th>TDK</th><th>摘要（meta description 兜底）</th><th>操作</th></tr>
                {% for g in tags %}
                    <tr>
                        <td><input type="number" name="position[{{ g.id }}]" value="{{ g.position }}" min="0" max="9999" style="width:72px"></td>
                        <td>{{ g.keyword }}</td>
                        <td>
                            <select name="chain[{{ g.id }}]">
                                {% for c in chains %}<option value="{{ c }}"{{ g.chain == c ? ' selected' }}>{{ c }}</option>{% endfor %}
                            </select>
                        </td>
                        <td>
                            {% if g.tdk_source == 'ai' %}AI{% elseif g.tdk_source == 'rule' %}规则{% elseif g.tdk_source == 'failed' %}失败待重试{% else %}待生成{% endif %}
                            {% if g.tdk_updated_at %}<br><small>{{ g.tdk_updated_at|date('m-d H:i') }}</small>{% endif %}
                        </td>
                        <td><textarea name="summary[{{ g.id }}]" rows="2" maxlength="500" style="width:100%">{{ g.summary }}</textarea></td>
                        <td>
                            <form method="post">
                                {{ f.token() }}
                                <input type="hidden" name="action" value="toggle">
                                <input type="hidden" name="id" value="{{ g.id }}">
                                <button type="submit">{{ g.status == 'active' ? '停用' : '启用' }}</button>
                            </form>
                            {% if g.status != 'active' %}<small>已停用</small>{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
            <div class="row settings-actions"><button type="submit">保存全部修改</button></div>
        </form>
    </div>
{% endblock %}
