{% extends 'layout.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% import 'macros/form.html.twig' as f %}
{% block content %}
    <div class="home-shell topic-page"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel">
            <div class="breadcrumb"><a href="{{ route_url('home') }}">首页</a><span>/</span><a href="{{ route_url('forum', {id: forum.id}) }}">{{ forum.name }}</a></div>
            <div class="post-topic-title">
                <h1 class="post-content-title"><a href="{{ topic_url }}">{{ t.title }}</a></h1>
                {{ ui.stats(t.view_count, t.reply_count) }}
            </div>
            <ul class="post-list topic-post-list">
                {% if page == 1 %}
                    {{ ui.post_row(t, t.body, t.created_at, {quote: current_uid, edit: can_manage_topic(t), edit_url: route_url('topic_edit', {id: t.id})}) }}
                {% endif %}
                {% for r in reply_rows %}
                    {{ ui.post_row(r, r.body, r.created_at, {quote: current_uid, edit: can_manage_reply(r), edit_url: route_url('reply_edit', {id: r.id})}, '', 0, 0, r.highlight, {reply_position: r.floor}) }}
                {% endfor %}
                {% if not replies and t.reply_count == 0 %}
                    <li class="empty-state">暂无回复</li>
                {% endif %}
            </ul>
            {% if pagination %}<div class="pagination-bar">{{ pagination.kind == 'simple' ? ui.simple_pagination(pagination.has_prev, pagination.has_next, pagination.page, pagination.url, pagination.limited) : ui.pagination(pagination.total, pagination.page, pagination.size, pagination.url, pagination.limited) }}</div>{% endif %}
            <div class="reply-panel" id="reply">
                <div class="reply-panel-head"><h3>发表回复</h3><span class="reply-status">{{ reply_status }}</span></div>
                {% if can_reply %}
                    <form class="ajax-reply-form" method="post" action="{{ route_url('reply_edit') }}">
                        {{ f.token() }}
                        <input type="hidden" name="topic_id" value="{{ t.id }}">
                        {{ f.textarea('内容', 'body', '', true) }}
                        <button type="submit" data-loading-text="正在回复">回复</button>
                    </form>
                {% elseif not current_uid %}
                    <div class="reply-login-box"><a href="{{ route_url('login') }}">登录后回复</a></div>
                {% elseif not can_reply_forum %}
                    <div class="reply-login-box disabled">当前用户组无回帖权限</div>
                {% else %}
                    <div class="reply-login-box disabled">当前用户禁止发言</div>
                {% endif %}
            </div>
        </div></div>
        <aside class="sidebar">{{ ui.user_card(null, true) }}</aside>
    </div></div>
    {% if can_reply %}<div class="topic-reply-bar"><a href="#reply">发表回复</a></div>{% endif %}
{% endblock %}
