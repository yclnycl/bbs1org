{% extends 'layout.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% import 'macros/form.html.twig' as f %}
{% block content %}
    <div class="home-shell search-page"><div class="forum-layout">
        <div class="forum-main"><div class="main-panel">
            <div class="search-page-head">
                <h2>{{ '聚合搜索'|t }}</h2>
                <form class="search-page-form" method="get" action="{{ route_url('search') }}" data-no-ajax="1">
                    <div class="search-page-query">
                        <input type="search" name="q" value="{{ query }}" placeholder="{{ '同时搜索标题、内容与回帖'|t }}"{{ f.length_attrs('q')|raw }} required autofocus>
                        <button type="submit">{{ '搜索'|t }}</button>
                    </div>
                </form>
                <p class="search-page-hint">{{ '一次命中帖子标题、正文与回帖，相关内容自动展开并标红。'|t }}</p>
            </div>
            {% if submitted and query == '' %}
                <div class="empty-state">{{ '请输入搜索关键词'|t }}</div>
            {% endif %}
            {% if query != '' %}
                <div class="search-page-summary">{{ '搜索'|t }}“{{ query }}”</div>
                {% if tag_match %}
                    <div class="search-tag-match">
                        <div class="search-tag-match-main">
                            <strong>{{ '已收录话题'|t }}：<a href="{{ tag_match.url }}">{{ tag_match.keyword }}</a></strong>
                            <span>{{ tag_match.summary }}</span>
                        </div>
                        <a class="search-tag-match-go" href="{{ tag_match.url }}">{{ '查看全部'|t }} {{ tag_match.total }} {{ '篇相关主题'|t }}</a>
                    </div>
                {% endif %}
                <ul class="post-list search-page-results">
                    {% if not results %}
                        <li class="empty-state">{{ '没有找到匹配的结果'|t }}</li>
                    {% else %}
                        {% for item in results %}
                            {%- set t = item.row -%}
                            {%- set hit = item.hit -%}
                            {%- set hits_html -%}
                                {%- if hit.body != '' or hit.replies -%}
                                <div class="search-result-hits">
                                    {%- if hit.body != '' -%}
                                    <p class="search-hit-line"><span class="search-hit-badge">{{ '内容'|t }}</span><span class="search-hit-text">{{ hit.body|raw }}</span></p>
                                    {%- endif -%}
                                    {%- for reply in hit.replies -%}
                                    <p class="search-hit-line"><span class="search-hit-badge">{{ '回帖'|t }}</span><span class="search-hit-text"><a class="search-hit-link" href="{{ reply.url }}">{{ reply.excerpt|raw }}</a><span class="search-hit-meta">{{ reply.author }} · {{ human_time(reply.time) }}</span></span></p>
                                    {%- endfor -%}
                                </div>
                                {%- endif -%}
                            {%- endset -%}
                            {{ ui.topic_list_row(t|merge({hits_html: hits_html}), 'comment') }}
                        {% endfor %}
                    {% endif %}
                </ul>
                {{ ui.search_pagination(has_prev, has_next, page, query) }}
            {% endif %}
        </div></div>
    </div></div>
{% endblock %}
