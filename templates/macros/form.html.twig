{#
    表单控件。控件标记集中在这里，PHP 只准备字段数据与取值。
    用法：{% import 'macros/form.html.twig' as f %}
#}

{% macro caption(label, help) %}<span>{{ label }}{% if help|default('') != '' %}<small>{{ help }}</small>{% endif %}</span>{% endmacro %}

{% macro length_attrs(name) %}
{%- set limits = length_limits(name) -%}
{%- if limits[0] is not null and limits[0] > 0 %} minlength="{{ limits[0] }}"{% endif -%}
{%- if limits[1] is not null %} maxlength="{{ limits[1] }}"{% endif -%}
{%- endmacro %}

{% macro token() %}<input type="hidden" name="_csrf" value="{{ csrf_token() }}">{% endmacro %}

{#
    人机验证：Cloudflare Turnstile。未接入（环境变量不齐）时两个宏都输出空，页面与未接入时完全一致。
    - turnstile(action) 放在 <form> 内：Turnstile 会往容器里插入 cf-turnstile-response 隐藏域随表单提交；
      action 取值与后端 turnstile_verify() 的入参一一对应（1-32 位字母/数字/下划线/连字符）。
    - turnstile_script() 放在页面的 scripts 块里；组件由前端 index.js 显式渲染（api.js?render=explicit），
      容器故意不带 cf-turnstile 类：带类会在 api.js 隐式渲染时重复渲染一次。
      显式渲染才能拿到 widget id，提交后按 id 重置——token 是一次性的，不重置第二次提交必然失败。
#}
{% macro turnstile(action) %}{% if turnstile_enabled() %}<div class="turnstile-field" data-turnstile data-sitekey="{{ turnstile_site_key() }}" data-action="{{ action }}" data-language="zh-cn"></div>{% endif %}{% endmacro %}

{% macro turnstile_script() %}{% if turnstile_enabled() %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>{% endif %}{% endmacro %}

{% macro hidden(fields) %}
{%- for name, value in fields %}{% if value is not null %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endif %}{% endfor -%}
{% endmacro %}

{% macro input(label, name, value, type, required, help, class) %}
<label class="grid{{ class|default('') != '' ? ' ' ~ class : '' }}">{{ _self.caption(label, help|default('')) }}<input name="{{ name }}" type="{{ type|default('text') }}" value="{{ value }}"{{ _self.length_attrs(name)|raw }}{{ required ? ' required' : '' }}></label>
{%- endmacro %}

{% macro textarea(label, name, value, required, help, class) %}
<label class="grid{{ class|default('') != '' ? ' ' ~ class : '' }}">{{ _self.caption(label, help|default('')) }}<textarea name="{{ name }}"{{ _self.length_attrs(name)|raw }}{{ required ? ' required' : '' }}>{{ value }}</textarea></label>
{%- endmacro %}

{#
    Markdown 编辑器：这里只输出带 data-markdown-editor 标记的文本域，
    工具条/预览由前端的开源编辑器 EasyMDE 接管（app/assets/vendor/easymde）。
    compact 用于帖子页底部的回帖框，标题说明整行显示。
#}
{% macro markdown_editor(label, name, value, required, compact, placeholder) %}
<div class="markdown-field{{ compact|default(false) ? ' markdown-field-compact' : '' }}">
    {{ _self.caption(label, '支持 Markdown：**粗体**、## 标题、- 列表、> 引用、| 表格 |') }}
    <textarea name="{{ name }}" data-markdown-editor data-preview-url="{{ route_url('preview') }}" placeholder="{{ placeholder|default('支持 Markdown 语法，可用工具栏插入格式') }}"{{ _self.length_attrs(name)|raw }}{{ required ? ' required data-markdown-required' : '' }}>{{ value }}</textarea>
</div>
{%- endmacro %}

{% macro checkbox(label, name, checked, help, class) %}
<label class="grid{{ class|default('') != '' ? ' ' ~ class : '' }}">{{ _self.caption(label, help|default('')) }}<input type="checkbox" name="{{ name }}" value="1"{{ checked ? ' checked' : '' }}></label>
{%- endmacro %}

{% macro number_input(label, name, value, min, max, required, help, class) %}
{%- set req = required is null ? true : required -%}
{%- set limits = (min is not null ? ' min="' ~ min|e ~ '"' : '') ~ (max is not null ? ' max="' ~ max|e ~ '"' : '') -%}
<label class="grid{{ class|default('') != '' ? ' ' ~ class : '' }}">{{ _self.caption(label, help|default('')) }}<input name="{{ name }}" type="number" value="{{ value }}"{{ limits|raw }}{{ req ? ' required' : '' }}></label>
{%- endmacro %}

{% macro select_input(label, name, value, options, help, class) %}
<label class="grid{{ class|default('') != '' ? ' ' ~ class : '' }}">{{ _self.caption(label, help|default('')) }}<select name="{{ name }}">{% for option_value, option_label in options %}<option value="{{ option_value }}"{{ (option_value ~ '') is same as (value ~ '') ? ' selected' : '' }}>{{ option_label }}</option>{% endfor %}</select></label>
{%- endmacro %}

{% macro forum_select(fid) %}
{%- set options = post_forum_options() -%}
{%- if fid <= 0 %}{% set fid = options|keys|first|default(0) %}{% endif -%}
{{- _self.select_input('版块', 'forum_id', fid, options) -}}
{%- endmacro %}

{% macro action_form(action, label, fields, class, confirm) %}
{%- set confirm_attr = confirm|default('') != '' ? ' data-confirm="' ~ confirm|e ~ '"' : '' -%}
<form class="post-action-form" method="post" action="{{ action }}"{{ confirm_attr|raw }}>{{ _self.token() }}{{ _self.hidden(fields) }}<button type="submit"{{ (class|default('') != '' ? ' class="' ~ class|e ~ '"' : '')|raw }}>{{ label }}</button></form>
{%- endmacro %}

{# 后台设置页按字段描述渲染整组控件 #}
{% macro render_fields(fields, values) %}
{%- for name, field in fields -%}
{%- set type = field.type|default('text') -%}
{%- set label = field.label|default(name) -%}
{%- set value = field.value is defined ? field.value : (values[name] is defined ? values[name] : '') -%}
{%- set help = field.help|default('') -%}
{%- set class = field.class|default('') -%}
{%- if help != '' and ' settings-help-field ' not in (' ' ~ class ~ ' ') %}{% set class = (class ~ ' settings-help-field')|trim %}{% endif -%}
{%- if type == 'checkbox' -%}
{{- _self.checkbox(label, name, value > 0, help, class) -}}
{%- elseif type == 'number' -%}
{{- _self.number_input(label, name, value, field.min is defined ? field.min : null, field.max is defined ? field.max : null, field.required is defined ? field.required : true, help, class) -}}
{%- elseif type == 'select' -%}
{{- _self.select_input(label, name, value, field.options|default({}), help, class) -}}
{%- elseif type == 'textarea' -%}
{{- _self.textarea(label, name, value, field.required|default(false), help, class) -}}
{%- else -%}
{{- _self.input(label, name, value, type, field.required|default(false), help, class) -}}
{%- endif -%}
{%- endfor -%}
{% endmacro %}
