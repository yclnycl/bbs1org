{% extends 'layout.html.twig' %}
{% block content %}
    <div class="home-shell"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel">
            <div class="form-panel topic-form-panel">
                <h2>{{ title }}</h2>
                <form method="post">
                    {{ form_token() }}
                    <input type="hidden" name="id" value="{{ t.id }}">
                    {{ select_forum(t.forum_id) }}
                    {{ input('标题', 'title', t.title, 'text', true) }}
                    {{ textarea('内容', 'body', t.body, true) }}
                    {{ reply_order|raw }}
                    {{ topic_ops|raw }}
                    <div class="topic-form-actions"><button type="submit" data-loading-text="{{ loading_text }}">保存</button></div>
                </form>
            </div>
        </div></div>
        {{ sidebar_stack_html([sidebar_user_card_html()]) }}
    </div></div>
{% endblock %}
