# 复制为 .env 后按需修改：cp .env.example .env
#
# 本地开发与线上生产用同一份 docker-compose.yml，所有差异都收在这里。

# 源码目录，相对 docker/ 目录。仓库里开发时就是上一层（仓库根 = 应用根）
BBS1ORG_PATH=..

# 对外端口：本地默认 8093（8080 常被本机其它服务占用）；线上写 8080，并只监听 127.0.0.1
HTTP_PORT=8090

# compose 项目名，决定数据卷前缀（bbs1org_data 等）。
# 线上必须保持 bbs1org，才能沿用现有数据卷（数据库就在里面）。
COMPOSE_PROJECT_NAME=bbs1org

# 站点信息：只在首次访问自动初始化那一次生效，之后以库里的站点设置为准
SITE_NAME=我的论坛
FORUM_NAME=默认版块
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 本地开发用的固定弱口令；留空则随机生成，写入 app/data/admin-password.txt 并打印到容器日志
ADMIN_PASSWORD=123456

# Cloudflare Turnstile 人机验证（登录 / 注册 / 发主题 / 回帖）。
# 三个变量必须同时有值才启用；任一留空即整体关闭——页面不渲染组件，后端也不校验。
# 只配一半是「以为开着其实没开」，程序会往调试日志写一条提醒。
# SITE_KEY 是公开值（渲染进页面），SECRET 是敏感值（只用于 siteverify，不落任何输出）。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# siteverify 返回的 hostname 白名单，逗号分隔。只会是本站自己的域名：
#   本地开发：localhost,127.0.0.1
#   线上生产：cncttc.com,www.cncttc.com（线上这份绝不写 localhost/127.0.0.1）
TURNSTILE_HOSTNAMES=
