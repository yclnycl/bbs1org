{% extends 'layout.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% block content %}
    <div class="home-shell{{ shell_class ? ' ' ~ shell_class : '' }}"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel">
            {% if not profile_uid and page_h1 %}
                <header class="list-heading">
                    <h1 class="list-title">{{ page_h1 }}</h1>
                    {% if page_h1_sub %}<p class="list-sub">{{ page_h1_sub }}</p>{% endif %}
                </header>
            {% endif %}
            {% if not profile_uid %}
                {% if carousel_rows %}
                    {% if ad_home_top != '' %}<aside class="ad-slot ad-home-top" aria-label="{{ '广告'|t }}"><span class="ad-label">{{ '广告'|t }}</span><div class="ad-body">{{ ad_home_top|raw }}</div></aside>{% endif %}
                    {% include 'partials/carousel.html.twig' with {carousel_rows: carousel_rows} only %}
                {% elseif ad_home_top != '' %}
                    <aside class="ad-slot ad-home-top" aria-label="{{ '广告'|t }}"><span class="ad-label">{{ '广告'|t }}</span><div class="ad-body">{{ ad_home_top|raw }}</div></aside>
                {% endif %}
            {% endif %}
            {% if category_tabs %}
                <div class="cat-tabs">{{ ui.tabs(category_tabs, category_active) }}</div>
            {% endif %}
            {% if profile_uid %}
                <div class="profile-toolbar">{{ ui.tabs(profile_tabs, profile_tab) }}</div>
            {% else %}
                {% if q == '' %}
                    <div class="mobile-forum-strip">
                        <a class="mobile-forum-link{{ fid ? '' : ' active' }}" href="{{ route_url('home') }}">{{ '全部'|t }}</a>
                        {% for f in mobile_forums %}
                            <a class="mobile-forum-link{{ f.id == fid ? ' active' : '' }}" href="{{ route_url('forum', {id: f.id}) }}">{{ f.name }}</a>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="topic-toolbar">
                    {{ ui.tabs(tab_items, sort) }}
                    {% if can_speak() %}<a class="tab-post" href="{{ route_url('topic_edit', fid ? {fid: fid} : {}) }}">{{ '+ 发帖'|t }}</a>{% endif %}
                </div>
            {% endif %}
            <ul class="post-list">
                {% if profile_uid and profile_tab_allowed and profile_tab == 'notifications' %}
                    {% if not rows %}
                        <li class="empty-state">{{ '暂无通知'|t }}</li>
                    {% else %}
                        {% for n in notification_rows %}
                            {% if n.divider %}<li class="notification-read-divider">{{ '下面的通知已读'|t }}</li>{% endif %}
                            {{ ui.notification_row(n.row) }}
                        {% endfor %}
                    {% endif %}
                {% elseif not rows %}
                    <li class="empty-state">{{ empty_text }}</li>
                {% else %}
                    {% for t in list_rows %}
                        {{ ui.topic_list_row(t, sort) }}
                        {% if ad_in_feed != '' and loop.index == 4 %}<li class="ad-slot ad-infeed" aria-label="{{ '广告'|t }}"><span class="ad-label">{{ '广告'|t }}</span><div class="ad-body">{{ ad_in_feed|raw }}</div></li>{% endif %}
                    {% endfor %}
                {% endif %}
            </ul>
            {% if pagination %}<div class="pagination-bar">{{ pagination.kind == 'simple' ? ui.simple_pagination(pagination.has_prev, pagination.has_next, pagination.page, pagination.url, pagination.limited) : ui.pagination(pagination.total, pagination.page, pagination.size, pagination.url, pagination.limited, pagination.hidden|default([])) }}</div>{% endif %}
        </div></div>
        <aside class="sidebar">{{ ui.user_card(sidebar_user, false, fid) }}
            {% if ad_sidebar != '' %}<aside class="ad-slot ad-sidebar" aria-label="{{ '广告'|t }}"><span class="ad-label">{{ '广告'|t }}</span><div class="ad-body">{{ ad_sidebar|raw }}</div></aside>{% endif %}
            {% if tag_chips %}
                <div class="side-tags">
                    <h3 class="side-tags-title">{{ '产业链话题'|t }}</h3>
                    {% for chain, tags in tag_chips %}
                        <h4 class="side-tags-chain">{{ chain }}</h4>
                        <div class="tag-strip">
                            {% for tg in tags %}
                                <a class="tag-chip" href="{{ route_url('tag', {kw: tg.keyword}) }}">{{ tg.keyword }}</a>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>
    </div></div>
{% endblock %}
