{% extends 'layout.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% import 'macros/form.html.twig' as f %}
{% block head %}{% if can_reply %}<link rel="stylesheet" href="{{ app_url('app/assets/vendor/easymde/easymde.min.css') }}?v={{ app_version }}">{% endif %}{% endblock %}
{% block scripts %}{% if can_reply %}<script src="{{ app_url('app/assets/vendor/easymde/easymde.min.js') }}?v={{ app_version }}" defer></script>{{ f.turnstile_script() }}{% endif %}{% endblock %}
{% block content %}
    <div class="home-shell topic-page"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel">
            <div class="breadcrumb"><a href="{{ route_url('home') }}">{{ '首页'|t }}</a><span>/</span><a href="{{ route_url('forum', {id: forum.id}) }}">{{ forum.name }}</a></div>
            <div class="post-topic-title">
                <h1 class="post-content-title"><a href="{{ topic_url }}">{{ t.title }}</a></h1>
                {{ ui.stats(t.view_count, t.reply_count) }}
            </div>
            {% if i18n_pending %}<div class="i18n-pending">{{ '该内容暂无英文译文，以下为中文原文，译文生成后会自动替换。'|t }}</div>{% endif %}
            <ul class="post-list topic-post-list">
                {% if page == 1 %}
                    {{ ui.post_row(t, t.body, t.created_at, {quote: current_uid, edit: can_manage_topic(t), edit_url: route_url('topic_edit', {id: t.id})}, '', 0, 0, false, {body_html: body_html_linked}) }}
                {% endif %}
                {% for r in reply_rows %}
                    {{ ui.post_row(r, r.body, r.created_at, {quote: current_uid, edit: can_manage_reply(r), edit_url: route_url('reply_edit', {id: r.id})}, '', 0, 0, r.highlight, {reply_position: r.floor}) }}
                {% endfor %}
                {% if not replies and t.reply_count == 0 %}
                    <li class="empty-state">{{ '暂无回复'|t }}</li>
                {% endif %}
            </ul>
            {% if topic_tags %}
                <div class="topic-tags-strip">
                    <span class="topic-tags-label">{{ '相关话题'|t }}</span>
                    <div class="tag-strip">
                        {% for tg in topic_tags %}<a class="tag-chip" href="{{ route_url('tag', {kw: tg}) }}">{{ tg }}</a>{% endfor %}
                    </div>
                </div>
            {% endif %}
            {% if pagination %}<div class="pagination-bar">{{ pagination.kind == 'simple' ? ui.simple_pagination(pagination.has_prev, pagination.has_next, pagination.page, pagination.url, pagination.limited) : ui.pagination(pagination.total, pagination.page, pagination.size, pagination.url, pagination.limited, pagination.hidden|default([])) }}</div>{% endif %}
            <div class="reply-panel" id="reply">
                <div class="reply-panel-head"><h3>{{ '发表回复'|t }}</h3><span class="reply-status">{{ reply_status }}</span></div>
                {% if can_reply %}
                    <form class="ajax-reply-form" method="post" action="{{ route_url('reply_edit') }}">
                        {{ f.token() }}
                        <input type="hidden" name="topic_id" value="{{ t.id }}">
                        {{ f.markdown_editor('内容'|t, 'body', '', true, true, '支持 Markdown 语法，可点工具栏按钮插入格式'|t) }}
                        {{ f.turnstile('reply') }}
                        <button type="submit" data-loading-text="{{ '正在回复'|t }}">{{ '回复'|t }}</button>
                    </form>
                {% elseif not current_uid %}
                    <div class="reply-login-box"><a href="{{ route_url('login') }}">{{ '登录后回复'|t }}</a></div>
                {% elseif not can_reply_forum %}
                    <div class="reply-login-box disabled">{{ '当前用户组无回帖权限'|t }}</div>
                {% else %}
                    <div class="reply-login-box disabled">{{ '当前用户禁止发言'|t }}</div>
                {% endif %}
            </div>
        </div></div>
        <aside class="sidebar">{{ ui.user_card(null, true) }}</aside>
    </div></div>
    {% if can_reply %}<div class="topic-reply-bar"><a href="#reply">{{ '发表回复'|t }}</a></div>{% endif %}
{% endblock %}
