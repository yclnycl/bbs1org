{% extends 'layout.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}
{% import 'macros/form.html.twig' as f %}
{% block content %}
    <div class="home-shell"><div class="forum-layout forum-layout-has-sidebar">
        <div class="forum-main"><div class="main-panel">
            <div class="form-panel reply-edit-panel">
                <div class="reply-edit-head"><h2>编辑回复</h2></div>
                <form method="post">
                    {{ f.token() }}
                    <input type="hidden" name="id" value="{{ r.id }}">
                    <input type="hidden" name="topic_id" value="{{ r.topic_id }}">
                    {{ f.textarea('内容', 'body', r.body, true) }}
                    {%- if r.id > 0 %}<label class="grid reply-action-field"><span>操作</span><select name="do" data-reply-actions aria-label="回复操作"><option value="">不操作</option><option value="delete" data-confirm="确定删除该回复？">删除</option>{% if can_manage() %}<option value="mute_author" data-confirm="确定禁言该作者？">禁言作者</option>{% endif %}</select></label>{% endif %}
                    <button type="submit" data-loading-text="正在保存">保存</button>
                </form>
            </div>
        </div></div>
        <aside class="sidebar">{{ ui.user_card() }}</aside>
    </div></div>
{% endblock %}
