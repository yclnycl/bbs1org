{% import 'macros/ui.html.twig' as ui %}
{% set active_forum = nav.active_forum %}
<div class="top">
    <div class="bar">
        <div class="bar-left">
            <a class="brand{{ nav.site_logo != '' ? ' brand-logo-custom' : '' }}" href="{{ route_url('home') }}">{% if nav.site_logo != '' %}<img class="brand-logo" src="{{ nav.site_logo }}" alt="{{ nav.site_name }}">{% endif %}<span class="brand-text">{{ nav.site_name }}</span></a>
            <nav class="forum-nav" aria-label="{{ '顶部版块'|t }}">
                {% for f in nav.visible_forums %}
                    <a class="forum-link{{ f.id == active_forum ? ' active' : '' }}" href="{{ route_url('forum', {id: f.id}) }}">{{ f.name }}</a>
                {% endfor %}
                {% if nav.has_more_forums %}
                    <button class="forum-more-toggle" type="button" data-forum-more-toggle aria-expanded="false" aria-controls="forum-more-region">{{ '全部'|t }}</button>
                {% endif %}
            </nav>
        </div>
        <div class="bar-right">
            {% if enabled_langs() %}
                <div class="lang-switch" role="group" aria-label="{{ '语言'|t }}">
                    <a class="lang-link{{ current_lang() == default_lang() ? ' active' : '' }}" href="{{ lang_switch_url(default_lang()) }}" hreflang="{{ default_lang() }}">中文</a>
                    {% for l in enabled_langs() %}<a class="lang-link{{ current_lang() == l ? ' active' : '' }}" href="{{ lang_switch_url(l) }}" hreflang="{{ l }}">{{ l|upper }}</a>{% endfor %}
                </div>
            {% endif %}
            <a class="search-page-link" href="{{ route_url('search') }}" aria-label="{{ '搜索'|t }}">
                <span class="search-page-fake-input">{{ '搜索'|t }}</span>
                <span class="search-page-fake-icon"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.7"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
            </a>
            <button class="mobile-menu-button" type="button" data-mobile-menu-open aria-label="{{ '打开菜单'|t }}" aria-controls="mobile-menu-drawer" aria-expanded="false">
                <svg width="19" height="19" viewBox="0 0 19 19" fill="none" aria-hidden="true"><path d="M3.5 5.5H15.5M3.5 9.5H15.5M3.5 13.5H15.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </button>
            <a class="nav-mine{{ nav.mine ? '' : ' nav-mine-guest' }}" href="{{ nav.mine_link }}" aria-label="{{ nav.mine ? '通知'|t : '登录'|t }}">{{ nav.mine ? ui.avatar(nav.mine.id, nav.mine.username, 'mobile-nav-avatar') : ui.icon('user') }}{% if nav.mine_unread > 0 %}<span class="mobile-nav-unread">{{ nav.mine_unread }}</span>{% endif %}</a>
        </div>
    </div>
</div>
{% if nav.has_more_forums %}
    <div class="forum-more-region" id="forum-more-region" hidden>
        <div class="forum-more-panel">
            <a class="forum-more-link{{ active_forum ? '' : ' active' }}" href="{{ route_url('home') }}">{{ '全部主题'|t }}</a>
            {% for f in nav.all_forums %}
                <a class="forum-more-link{{ f.id == active_forum ? ' active' : '' }}" href="{{ route_url('forum', {id: f.id}) }}">{{ f.name }}</a>
            {% endfor %}
        </div>
    </div>
{% endif %}
<div class="mobile-menu-backdrop" id="mobile-menu" data-mobile-menu-url="{{ route_url('mobile_menu') }}" hidden>
    <aside class="mobile-menu-drawer" id="mobile-menu-drawer" aria-label="{{ '移动端菜单'|t }}">
        <div class="mobile-menu-head"><strong>{{ '菜单'|t }}</strong><button type="button" class="mobile-menu-close" data-mobile-menu-close aria-label="{{ '关闭菜单'|t }}">×</button></div>
        <div class="mobile-menu-body"></div>
    </aside>
</div>
